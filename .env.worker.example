# Agent worker. Copy to .env.worker on the machine/container that runs agents.
PAIRLOOM_SERVER_URL=http://localhost:8787
# Shown once when an owner registers a worker in the project page.
PAIRLOOM_WORKER_TOKEN=
# A dedicated git clone of the project (e.g. Rogue) that only the worker uses.
PAIRLOOM_REPO_PATH=
PAIRLOOM_WORKTREES_DIR=./data/worktrees
PAIRLOOM_STATE_DIR=./data/worker-state

# Model credential for REAL sessions (one of these). Without it, only simulated sessions run.
ANTHROPIC_API_KEY=
# CLAUDE_CODE_USE_BEDROCK=1
# CLAUDE_CODE_USE_VERTEX=1

# Guardrails per agent session.
CLAUDE_MAX_TURNS=50
CLAUDE_MAX_BUDGET_USD=5
# CLAUDE_MODEL=
PAIRLOOM_SIMULATED_STEP_MS=600
