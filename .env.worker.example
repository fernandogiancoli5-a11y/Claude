# Agent worker. Copy to .env.worker on the machine/container that runs agents.
# Placeholders only — never commit real values.
PAIRLOOM_SERVER_URL=http://localhost:8787
# Shown once when an owner registers a worker on the project page.
PAIRLOOM_WORKER_TOKEN=
# A dedicated git clone the worker owns. For demos: `npm run sample:repo` creates ./data/sample-repo
PAIRLOOM_REPO_PATH=./data/sample-repo
PAIRLOOM_WORKTREES_DIR=./data/worktrees
# Holds the event outbox, agent transcripts (used for resume) and a sandbox HOME. Put it on a persistent volume.
PAIRLOOM_STATE_DIR=./data/worker-state

# ---- Real agent: Pairloom harness over an OpenAI-compatible API ----
# Primary provider. Without a key, only SIMULATED sessions are available.
LLM_PROVIDER=groq
GROQ_API_KEY=
# Default model for groq: openai/gpt-oss-120b. Override only after checking tool-use support.
# LLM_MODEL=
# Alternative (configuration only, not yet exercised): LLM_PROVIDER=openai with OPENAI_API_KEY=
# Custom/compatible endpoint: LLM_BASE_URL=https://... (shown in the UI as "custom endpoint"; no assumed pricing)
# LLM_REASONING_EFFORT=low|medium|high
LLM_MAX_COMPLETION_TOKENS=4096
LLM_REQUEST_TIMEOUT_MS=90000
# Retries only for 429/5xx/network, never for auth or quota; each retry counts as a model call.
LLM_MAX_RETRIES=1
LLM_MAX_RETRY_WAIT_SEC=20
# Override published prices (USD per 1M tokens) used for cost estimates.
# LLM_PRICE_INPUT_PER_MTOK=
# LLM_PRICE_CACHED_INPUT_PER_MTOK=
# LLM_PRICE_OUTPUT_PER_MTOK=

# ---- Per-session guardrails ----
AGENT_MAX_ITERATIONS_PER_TURN=25
AGENT_MAX_MODEL_CALLS_PER_SESSION=80
AGENT_MAX_TURN_SECONDS=600
# Estimated spend cap; "none" disables it (only sensible when pricing is unknown and you accept that).
AGENT_MAX_COST_USD_PER_SESSION=0.50
AGENT_COMMAND_TIMEOUT_SECONDS=120

PAIRLOOM_SIMULATED_STEP_MS=600
# Legacy opt-in: PAIRLOOM_REAL_ADAPTER=claude-agent-sdk (needs an Anthropic credential; not used by the MVP)
