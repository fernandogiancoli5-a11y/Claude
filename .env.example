# Collaboration server. Copy to .env (never commit real values).
PORT=8787
HOST=127.0.0.1
# Public URL users open; used for invite links, cookie Secure flag and Origin checks.
PUBLIC_ORIGIN=http://localhost:8787
# Extra origins allowed to call the API / open WebSockets (dev: the Vite server).
ALLOWED_ORIGINS=http://localhost:5173
DATABASE_PATH=./data/pairloom.sqlite
# Serve the built web app from the server (production).
WEB_DIST_DIR=./apps/web/dist
# Serve the public marketing site (with the waitlist) at "/" and move the app to "/app/".
# Build it with PAIRLOOM_CONTACT_EMAIL set so the privacy page names a real contact.
# SITE_DIST_DIR=./apps/site/dist
# Set to false in production so only invitation holders can sign up.
OPEN_SIGNUP=true
SESSION_TTL_HOURS=168
INVITE_TTL_HOURS=72
# true when behind a reverse proxy that sets X-Forwarded-*.
TRUST_PROXY=false
LOG_LEVEL=info
# Server-side WebSocket liveness ping; sockets that miss one interval are dropped.
WS_HEARTBEAT_MS=20000
