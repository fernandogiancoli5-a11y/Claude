# Collaboration server. Copy to .env (never commit real values).
PORT=8787
HOST=127.0.0.1
# Public URL users open; used for invite links, cookie Secure flag and Origin checks.
PUBLIC_ORIGIN=http://localhost:8787
# Extra origins allowed to call the API / open WebSockets (dev: the Vite server).
ALLOWED_ORIGINS=http://localhost:5173
DATABASE_PATH=./data/pairloom.sqlite
# Serve the built web app from the server (production).
WEB_DIST_DIR=./apps/web/dist
# Serve the public marketing site (with the waitlist) at "/" and move the app to "/app/".
# Build it with PAIRLOOM_CONTACT_EMAIL set so the privacy page names a real contact.
# SITE_DIST_DIR=./apps/site/dist
# Site build options: show the site's "Sign in" link (https:// URL or a path like /app/), and
# which waitlist storage the privacy page describes ("server" here; Netlify sets "supabase").
# PAIRLOOM_APP_URL=/app/
# PAIRLOOM_WAITLIST_BACKEND=server
# Pairloom-hosted workspaces: the server creates each project's git repository and runs its agent
# worker itself (on THIS machine; the agent reads and edits files, it never runs project code).
# `npm run dev` turns this on.
# PAIRLOOM_HOSTED_WORKERS=true
# PAIRLOOM_HOSTED_DIR=./data/hosted
# Hosted workers NEVER run project code (tests/commands) by default: nothing isolates that code
# from this server's secrets, database and other projects. The agent can still read and edit
# files and propose diffs. Only on a private machine where every project is trusted, you may
# accept that risk explicitly (any other value keeps execution off):
# PAIRLOOM_HOSTED_CODE_EXECUTION=unsafe-allow
# The hosted agent's model key (free at console.groq.com). Server-side only; never sent to browsers.
# GROQ_API_KEY=
# Free-tier reality (checked 2026-10-28 at console.groq.com/docs/rate-limits): openai/gpt-oss-120b
# allows about 30 requests/min, 8K tokens/min and 200K tokens/DAY per account, shared by every
# task on this server. Each model has its own allowance, so switching model is the quickest
# relief when one runs out, e.g. LLM_MODEL=openai/gpt-oss-20b (smaller, weaker at multi-file
# edits). Any OpenAI-compatible endpoint works via LLM_BASE_URL + LLM_API_KEY_ENV + LLM_MODEL.
# LLM_MODEL=openai/gpt-oss-120b
# Per-turn safeguards so one task can't spend the whole day's allowance:
# AGENT_MAX_TOKENS_PER_TURN=60000
# AGENT_MAX_ITERATIONS_PER_TURN=25
# AGENT_MAX_TURN_SECONDS=600
# Public-repo imports are refused above these sizes (checked after cloning):
# PAIRLOOM_IMPORT_MAX_MB=200
# PAIRLOOM_IMPORT_MAX_FILES=20000
# PAIRLOOM_IMPORT_TIMEOUT_SECONDS=120
# Set to false in production so only invitation holders can sign up.
OPEN_SIGNUP=true
SESSION_TTL_HOURS=168
INVITE_TTL_HOURS=72
# true when behind a reverse proxy that sets X-Forwarded-*.
TRUST_PROXY=false
LOG_LEVEL=info
# Server-side WebSocket liveness ping; sockets that miss one interval are dropped.
WS_HEARTBEAT_MS=20000
